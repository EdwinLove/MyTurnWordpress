{
    "name": "edwinlove/myturn-wordpress",
    "description": "WordPress adapter for the framework-independent MyTurn core",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.4",
        "edwinlove/myturn-core": "^1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/EdwinLove/MyTurn"
        }
    ],
    "autoload": {
        "psr-4": {
            "EdwinLove\\MyTurn\\WordPress\\": "src/"
        }
    }
}
